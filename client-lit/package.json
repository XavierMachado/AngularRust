{
  "name": "webtransport-console-lit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" index.html vitest.setup.ts"
  },
  "dependencies": {
    "@lit-labs/signals": "0.1.3",
    "@shoelace-style/shoelace": "2.20.1",
    "@vaadin/router": "2.0.0",
    "lit": "^3.3.0",
    "wt-wasm": "file:../wasm/pkg"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~5.8.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
