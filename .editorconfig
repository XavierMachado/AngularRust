# Whitespace rules shared by both sides. Prettier owns client/, rustfmt owns
# server/; this is what the editor does before either of them runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
max_line_length = 100

[*.rs]
indent_size = 4

[*.{ts,js,json,html,css,yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
# Recipe lines must start with a real tab.
indent_style = tab
