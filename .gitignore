# Rust — the workspace builds into one target directory at the root
/target/

# Angular
/client/node_modules/
/client/dist/
/client/.angular/
/client/coverage/
/client/out-tsc/

# Lit
/client-lit/node_modules/
/client-lit/dist/

# Desktop shell (its own target; the crate opts out of the workspace)
/desktop/target/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Cargo.lock is deliberately not ignored: this crate builds a binary, so the
# resolved versions belong in the repo.
